{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "override_builtin": {
      "default": false,
      "type": "boolean"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "schema_version"
  ],
  "title": "Metadata",
  "type": "object"
}
